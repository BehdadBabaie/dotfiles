// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╔════════════╗",
            "type": "custom"
        },
        {
            "key": "║ {#31}  user    {#keys}║",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "║ {#34}{icon}  distro  {#keys}║",
            "type": "title",
            "format": "Archlinux"
        },
        {
            "key": "║ {#33}󰅐  uptime  {#keys}║",
            "type": "uptime"
        },
        {
            "key": "║ {#35}  kernel  {#keys}║",
            "type": "kernel"
        },
        {
            "key": "║ {#36}󰇄  desktop {#keys}║",
            "type": "de"
        },
        {
            "key": "║ {#31}  term    {#keys}║",
            "type": "terminal"
        },
        {
            "key": "║ {#32}  shell   {#keys}║",
            "type": "shell"
        },
        {
            "key": "║ {#34}󰉉  disk    {#keys}║",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "╠════════════╣",
            "type": "custom"
        },
        {
            "key": "║ {#39}  colors  {#keys}║",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╚════════════╝",
            "type": "custom"
        }
    ]
}
